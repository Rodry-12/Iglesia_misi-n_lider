# PLANTILLA: reemplazar valores en el gestor de variables del servidor.
# .NET NO carga archivos .env automáticamente. No subir una copia completada a Git.
# DOMINIO_APP sirve Angular; DOMINIO_API sirve el backend. Pueden ser iguales.

# 1. Entorno y origen público
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
AllowedHosts=REEMPLAZAR_DOMINIO_API
Security__AllowedOrigins__0=https://REEMPLAZAR_DOMINIO_APP
# Activar SOLO si el servidor termina HTTPS en un proxy de IP conocida.
ReverseProxy__Enabled=false
ReverseProxy__ForwardLimit=1
# ReverseProxy__KnownProxies__0=REEMPLAZAR_IP_REAL_PROXY
# No activar ASPNETCORE_FORWARDEDHEADERS_ENABLED ni confianza universal en cabeceras.
# Escoger SOLO el modo que corresponda al servidor:
# A) HTTPS directo en Kestrel (certificado TLS, diferente del PFX de Data Protection):
# ASPNETCORE_URLS=https://0.0.0.0:8443
# Kestrel__Certificates__Default__Path=/run/secrets/mlp-https.pfx
# Kestrel__Certificates__Default__Password=REEMPLAZAR_PASSWORD_CERTIFICADO_HTTPS
# B) HTTPS en proxy confiable + HTTP interno: activar ReverseProxy y sus IPs reales.
# ASPNETCORE_HTTP_PORTS=8080
# El puerto HTTP interno debe quedar accesible exclusivamente al proxy.

# 2. Supabase existente: Session pooler, puerto 5432, DOS logins diferentes.
# Reutilizar las cadenas privadas ya verificadas; estos valores NO son credenciales.
Database__ConnectionString="Host=aws-1-us-east-2.pooler.supabase.com;Port=5432;Database=postgres;Username=REEMPLAZAR_LOGIN_MINISTERIAL.sneceodpvscrvjrlqwgw;Password=REEMPLAZAR_PASSWORD_MINISTERIAL;SSL Mode=VerifyFull;Pooling=true;Maximum Pool Size=10;No Reset On Close=false;Multiplexing=false"
Database__IdentityConnectionString="Host=aws-1-us-east-2.pooler.supabase.com;Port=5432;Database=postgres;Username=REEMPLAZAR_LOGIN_IDENTITY.sneceodpvscrvjrlqwgw;Password=REEMPLAZAR_PASSWORD_IDENTITY;SSL Mode=VerifyFull;Pooling=true;Maximum Pool Size=10;No Reset On Close=false;Multiplexing=false"
Database__RequireVerifiedTls=true
Database__IdentityPoolingEnabled=true
Database__IdentityPoolMaximumSize=10

# 3. Contexto firmado: conservar ID y clave VIGENTES, sin generar otros.
DatabaseActor__KeyId=REEMPLAZAR_ID_CLAVE_VIGENTE
DatabaseActor__SigningKeyBase64=REEMPLAZAR_CLAVE_BASE64_VIGENTE

# 4. Data Protection: ejemplos Linux; adaptar al usuario real del proceso.
# Directorio persistente privado + PFX de protección de datos (no certificado localhost).
Security__KeyRingPath=/home/app/.local/share/MisionLiderParis/keys
Security__KeyCertificatePath=/run/secrets/mlp-data-protection.pfx
Security__KeyCertificatePassword=REEMPLAZAR_PASSWORD_PFX
Security__RequireConfirmedEmail=true
Security__PasswordLength=12
Security__CookieMinutes=30
Security__ResetTokenMinutes=30
Security__MaxFailedAccessAttempts=5
Security__LockoutMinutes=15

# 5. Correo transaccional: Gmail institucional confirmado por el usuario.
Email__Provider=GmailApi
Email__From=iglesiamisionliderparis@gmail.com
Email__ReplyTo=iglesiamisionliderparis@gmail.com
Email__InvitationUrl=https://REEMPLAZAR_DOMINIO_APP/activar-cuenta
Email__RecoveryUrl=https://REEMPLAZAR_DOMINIO_APP/restablecer-contrasena
Email__ConfirmationUrl=https://REEMPLAZAR_DOMINIO_APP/confirmar-correo
Email__InvitationMinutes=1440
GoogleGmail__ClientId=REEMPLAZAR_CLIENT_ID_OAUTH_WEB
GoogleGmail__ClientSecret=REEMPLAZAR_CLIENT_SECRET_OAUTH
GoogleGmail__RedirectUri=https://REEMPLAZAR_DOMINIO_API/api/v1/integrations/google/callback
# Persistente, privado, bajo HOME del proceso y fuera de la aplicación.
GoogleGmail__TokenStorePath=/home/app/.local/share/MisionLiderParis/gmail/credential.bin
# RefreshToken se obtiene con el callback; no pegarlo aquí ni publicar un placeholder.

# 6. Logs: sin SQL, cookies, cuerpos ni métricas detalladas permanentes.
Logging__LogLevel__Default=Warning
# Los filtros Microsoft.AspNetCore/EF/Diagnostics ya están en appsettings.json.
Diagnostics__Performance__Enabled=false
Diagnostics__Performance__CommandDetails=false
Diagnostics__Performance__AllowProduction=false

# No configurar MigrationConnectionString, InspectorConnectionString ni MLP_BOOTSTRAP_*.
# Puerto/Kestrel/proxy HTTPS se configuran según el servidor, no con valores localhost.

# 7. Monitor PostgreSQL: opcional, denegado si falta o es inválido.
# Generar 32 bytes criptográficos y codificar como 64 caracteres hexadecimales.
# Configurar el mismo valor PRIVADO en el servidor y en GitHub Actions Secrets.
# MLP_HEALTH_TOKEN=CONFIGURAR_EN_GESTOR_DE_SECRETOS
