{
  "name": "iglesia-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node ../scripts/check-assets.mjs",
    "start": "ng serve",
    "build": "ng build",
    "prebuild": "node ../scripts/check-assets.mjs",
    "postbuild": "node ../scripts/prepare-ui-notices.mjs",
    "prewatch": "node ../scripts/check-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e playwright.config.ts *.json",
    "format:check": "prettier --check src e2e playwright.config.ts *.json"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@lucide/angular": "1.59.0",
    "@primeuix/themes": "2.0.3",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "28.1.0",
    "postcss": "8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "vitest": "4.0.18"
  }
}
