# Documentation only: .NET does not automatically load .env files.
# Set environment variables in the shell/host or use dotnet user-secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7243
Database__ConnectionString=
# Operator commands only; never selected by normal API startup. Remove after bootstrap/migration work.
Database__MigrationConnectionString=
Database__RequireVerifiedTls=true
Security__AllowedOrigins__0=https://localhost:4200
Security__MaxFailedAccessAttempts=5
Security__LockoutMinutes=15
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__From=
Email__RecoveryUrl=
Email__ConfirmationUrl=
# Production only: persistent key storage and a certificate to encrypt keys at rest.
Security__KeyRingPath=
Security__KeyCertificatePath=
Security__KeyCertificatePassword=
# Temporary variables used only by the explicit bootstrap command; remove afterwards.
MLP_BOOTSTRAP_EMAIL=
MLP_BOOTSTRAP_PASSWORD=
