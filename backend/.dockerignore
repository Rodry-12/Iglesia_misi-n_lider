
# Deny by default: only the production API source/dependencies enter the context.
**
!Dockerfile
!.dockerignore
!global.json
!Directory.Build.props
!Directory.Packages.props
!NuGet.Config
!src/
!src/MisionLiderParis.Domain/
!src/MisionLiderParis.Application/
!src/MisionLiderParis.Infrastructure/
!src/MisionLiderParis.Api/
!src/MisionLiderParis.Domain/**
!src/MisionLiderParis.Application/**
!src/MisionLiderParis.Infrastructure/**
!src/MisionLiderParis.Api/**
!docs/
!docs/reference/
!docs/reference/ministerial-reconstruction.sql.reference.txt

# Re-exclude generated C# and any private content.
**/bin/**
**/obj/**
**/.git/**
**/.vs/**
**/.vscode/**
**/node_modules/**
**/.local/**
**/artifacts/**
**/TestResults/**
**/coverage/**
**/Properties/**

# Deny JSON files by default, then allow only required build files.
**/*.json
!global.json
!src/**/packages.lock.json
!src/MisionLiderParis.Api/appsettings.json

# Deny text files except the required public reference.
**/*.txt
!docs/reference/ministerial-reconstruction.sql.reference.txt

# Never include private configuration or secrets.
**/secrets/**
**/.secrets/**
**/.env
**/.env.*
**/appsettings.*.json
**/*.pfx
**/*.p12
**/*.key
**/*.pem
**/*.credential
**/credential.bin
**/secrets.json
**/*token*.json
**/*oauth*.json
